-- UTILS
-- v7 FIXES: drag integrated, background consistency, password spacing, minimize/close stable

local function tween(obj, props, time, style)
	TweenService:Create(
		obj,
		TweenInfo.new(time or 0.35, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		props
	):Play()
end

local function corner(p,r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0,r)
	c.Parent = p
end

local function dragify(frame, handle)
	handle = handle or frame
	local dragging, dragStart, startPos
	handle.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = i.Position
			startPos = frame.Position
		end
	end)
	UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
	end)
	RunService.RenderStepped:Connect(function()
		if dragging then
			local delta = UserInputService:GetMouseLocation() - dragStart
			frame.Position = UDim2.new(startPos.X.Scale,startPos.X.Offset+delta.X,startPos.Y.Scale,startPos.Y.Offset+delta.Y)
		end
	end)
end

-- PASSWORD SCREEN
function UILibrary:PasswordGate(password, onSuccess)
	local player = Players.LocalPlayer
	local gui = Instance.new("ScreenGui", player.PlayerGui)
	gui.Name = "PasswordGate"

	local blur = Instance.new("Frame", gui)
	blur.Size = UDim2.fromScale(1,1)
	blur.BackgroundColor3 = Color3.fromRGB(0,0,0)
	blur.BackgroundTransparency = 0.4

	local box = Instance.new("Frame", gui)
	box.Size = UDim2.fromScale(0.3,0.25)
	box.Position = UDim2.fromScale(0.35,0.35)
	box.BackgroundColor3 = UILibrary.CurrentTheme.Background
	corner(box,20)
	dragify(box)

	local title = Instance.new("TextLabel", box)
	title.Size = UDim2.new(1,0,0,50)
	title.Text = "🔒 Secure Access"
	title.Font = Enum.Font.GothamBlack
	title.TextSize = 22
	title.TextColor3 = UILibrary.CurrentTheme.Text
	title.BackgroundTransparency = 1

	local input = Instance.new("TextBox", box)
	input.PlaceholderText = "Enter password"
	input.Size = UDim2.new(0.8,0,0,40)
	input.Position = UDim2.new(0.1,0,0.45,0)
	input.Text = ""
	input.Font = Enum.Font.Gotham
	input.TextSize = 16
	input.TextColor3 = UILibrary.CurrentTheme.Text
	input.BackgroundColor3 = UILibrary.CurrentTheme.Secondary
	input.ClearTextOnFocus = false
	corner(input,12)

	local btn = Instance.new("TextButton", box)
	btn.Size = UDim2.new(0.5,0,0,40)
	btn.Position = UDim2.new(0.25,0,1.1,0)
	btn.Text = "Unlock"
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 16
	btn.TextColor3 = UILibrary.CurrentTheme.Text
	btn.BackgroundColor3 = UILibrary.CurrentTheme.Primary
	corner(btn,12)

	btn.MouseButton1Click:Connect(function()
		if input.Text == password then
			tween(box,{Size=UDim2.fromScale(0,0),Transparency=1},0.3)
			task.wait(0.3)
			gui:Destroy()
			onSuccess()
		else
			tween(box,{Rotation=5},0.1)
			task.wait(0.1)
			tween(box,{Rotation=-5},0.1)
			task.wait(0.1)
			tween(box,{Rotation=0},0.1)
		end
	end)
end

-- WINDOW
function UILibrary:CreateWindow(title, keybind)
	local theme = UILibrary.CurrentTheme
	local player = Players.LocalPlayer
	local toggleKey = keybind or Enum.KeyCode.RightShift

	local gui = Instance.new("ScreenGui", player.PlayerGui)
	gui.Name = "AdvancedUIv4"

	local main = Instance.new("Frame", gui)
	main.Size = UDim2.fromScale(0.38,0.5)
	main.Position = UDim2.fromScale(0.31,0.25)
	main.BackgroundColor3 = theme.Background
	corner(main,20)
	dragify(main)

	local top = Instance.new("Frame", main)
	top.Size = UDim2.new(1,0,0,55)
	top.BackgroundColor3 = theme.Secondary
	corner(top,20)

	local titleLbl = Instance.new("TextLabel", top)
	titleLbl.Text = title
	titleLbl.Size = UDim2.new(1,-100,1,0)
	titleLbl.Position = UDim2.new(0,20,0,0)
	titleLbl.Font = Enum.Font.GothamBlack
	titleLbl.TextSize = 22
	titleLbl.TextColor3 = theme.Text
	titleLbl.BackgroundTransparency = 1

	local tabBar = Instance.new("Frame", main)
	tabBar.Position = UDim2.new(0,15,0,70)
	tabBar.Size = UDim2.new(1,-30,0,45)
	tabBar.BackgroundTransparency = 1

	local tabLayout = Instance.new("UIListLayout", tabBar)
	tabLayout.FillDirection = Enum.FillDirection.Horizontal
	tabLayout.Padding = UDim.new(0,10)

	local pages = Instance.new("Frame", main)
	pages.Position = UDim2.new(0,15,0,125)
	pages.Size = UDim2.new(1,-30,1,-140)
	pages.BackgroundTransparency = 1

	UserInputService.InputBegan:Connect(function(i,gp)
		if not gp and i.KeyCode == toggleKey then
			gui.Enabled = not gui.Enabled
		end
	end)

	local window = {}
	local tabs = {}
	local config = {}

	function window:CreateTab(name)
		local btn = Instance.new("TextButton", tabBar)
		btn.Size = UDim2.new(0,130,1,0)
		btn.Text = name
		btn.Font = Enum.Font.GothamBold
		btn.TextSize = 15
		btn.TextColor3 = theme.Text
		btn.BackgroundColor3 = theme.Secondary
		corner(btn,12)

		local page = Instance.new("ScrollingFrame", pages)
		page.Size = UDim2.new(1,0,1,0)
		page.CanvasSize = UDim2.new(0,0,0,0)
		page.AutomaticCanvasSize = Enum.AutomaticSize.Y
		page.ScrollBarImageTransparency = 1
		page.Visible = false

		local layout = Instance.new("UIListLayout", page)
		layout.Padding = UDim.new(0,12)

		btn.MouseButton1Click:Connect(function()
			for _,t in pairs(tabs) do
				t.Page.Visible = false
				t.Button.BackgroundColor3 = theme.Secondary
			end
			page.Visible = true
			tween(btn,{BackgroundColor3=theme.Primary},0.25)
		end)

		if #tabs == 0 then
			page.Visible = true
			btn.BackgroundColor3 = theme.Primary
		end

		table.insert(tabs,{Button=btn,Page=page})

		local tab = {}

		function tab:AddToggle(text, default, callback)
			local state = default or false
			config[text] = state

			local holder = Instance.new("Frame", page)
			holder.Size = UDim2.new(1,0,0,45)
			holder.BackgroundColor3 = theme.Secondary
			corner(holder,12)

			local lbl = Instance.new("TextLabel", holder)
			lbl.Text = text
			lbl.Size = UDim2.new(0.7,0,1,0)
			lbl.Position = UDim2.new(0,15,0,0)
			lbl.TextColor3 = theme.Text
			lbl.BackgroundTransparency = 1
			lbl.TextXAlignment = Enum.TextXAlignment.Left

			local toggle = Instance.new("TextButton", holder)
			toggle.Size = UDim2.new(0,50,0,26)
			toggle.Position = UDim2.new(1,-70,0.5,-13)
			toggle.Text = ""
			toggle.BackgroundColor3 = theme.Background
			corner(toggle,20)

			local knob = Instance.new("Frame", toggle)
			knob.Size = UDim2.new(0,22,0,22)
			knob.Position = state and UDim2.new(1,-24,0.5,-11) or UDim2.new(0,2,0.5,-11)
			knob.BackgroundColor3 = state and theme.Primary or theme.SubText
			corner(knob,20)

			toggle.MouseButton1Click:Connect(function()
				state = not state
				config[text] = state
				tween(knob,{
					Position = state and UDim2.new(1,-24,0.5,-11) or UDim2.new(0,2,0.5,-11),
					BackgroundColor3 = state and theme.Primary or theme.SubText
				},0.25)
				if callback then callback(state) end
			end)

			if callback then callback(state) end
		end

		return tab
	end

	function window:SaveConfig()
		writefile("ui_config.json", HttpService:JSONEncode(config))
	end

	function window:LoadConfig()
		if isfile("ui_config.json") then
			config = HttpService:JSONDecode(readfile("ui_config.json"))
		end
	end

	return window
end

return UILibrary
